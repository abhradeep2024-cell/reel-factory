// Reel Factory — Cloudflare Worker configuration (R2 variant)
// Deploy with this config once R2 is enabled on the account:
//   npm run db:remote && npm run deploy:r2
// R2 bucket "reel-factory-media" stores rendered MP4s and thumbnails and
// serves them publicly at /media/<key> for the Instagram crawler to fetch.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reel-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/internal/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel-factory-db",
      "database_id": "7822121c-eee5-4c0a-aef8-acf6c20e9716",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "reel-factory-media"
    }
  ],
  "triggers": {
    "crons": [
      "30 2 * * *",
      "0 * * * *",
      "35 2 * * 1"
    ]
  },
  "observability": { "enabled": true }
}
